# Alleen bij imap.auth = "password". Hotmail gebruikt OAuth (npm run login), dan blijft dit leeg.
IMAP_PASSWORD=

# Alleen nodig als claude.enabled = true
ANTHROPIC_API_KEY=

# provider "callmebot": API-key die je van CallMeBot via WhatsApp krijgt
CALLMEBOT_APIKEY=

# provider "twilio"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# bv. whatsapp:+14155238886 (Twilio-sandbox) of je eigen goedgekeurde nummer
TWILIO_FROM=
